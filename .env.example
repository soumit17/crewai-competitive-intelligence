ANTHROPIC_API_KEY=
# OPENAI_API_KEY intentionally absent: the project must run without it (tests assert this).

MODEL_DEV=anthropic/claude-haiku-5-5
MODEL_FINAL=anthropic/claude-sonnet-5-5
# Safety net: CrewAI's create_llm() reads MODEL before falling back to its OpenAI default (gpt-4.1-mini).
# Every component is still configured explicitly; this only catches one we missed.
MODEL=anthropic/claude-haiku-5-5

P3_SPEND_CAP_USD=12
MAX_TOKENS=1500

# Local embedder for memory + knowledge. "onnx" = all-MiniLM-L6-v2 via chromadb (already a crewai dependency).
# Alternative: "sentence-transformer" with BAAI/bge-small-en-v1.5 (pulls in torch). See docs/decisions.md.
EMBEDDER_PROVIDER=onnx
EMBEDDER_MODEL=all-MiniLM-L6-v2

FAKEWEB_URL=http://127.0.0.1:8765

# Verified names in crewai 1.15.33 source
CREWAI_TRACING_ENABLED=false
CREWAI_DISABLE_TELEMETRY=true
CREWAI_DISABLE_VERSION_CHECK=true
